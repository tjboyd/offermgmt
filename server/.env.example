# Application
NODE_ENV=production
PORT=3001

# Base URLs — set to your Railway public domain in production
# e.g. https://your-app.up.railway.app
APP_BASE_URL=https://your-app.up.railway.app
OFFERS_BASE_URL=https://your-app.up.railway.app

# Database — Railway provides this automatically when you add a Postgres service
DATABASE_URL=postgresql://postgres:password@localhost:5432/jrc_offers

# Auth secrets — generate with: openssl rand -hex 32
JWT_SIGNING_KEY=replace_with_32_plus_byte_hex_string
INTEGRATION_ENCRYPTION_KEY=replace_with_32_byte_hex_string

# SendGrid webhook signing key (optional — from SendGrid dashboard)
SENDGRID_WEBHOOK_SIGNING_KEY=replace_with_sendgrid_webhook_key
